{
  "name": "autorecorder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "record": "tsx cli.ts",
    "record:all": "tsx cli.ts",
    "record:list": "tsx cli.ts --list",
    "doctor": "node ../ci/write-versions.mjs && tsx cli.ts --doctor",
    "doctor:online": "node ../ci/write-versions.mjs && tsx cli.ts --doctor --online",
    "manifest": "tsx manifest.ts",
    "manifest:check": "tsx manifest.ts --check",
    "typecheck": "tsc --noEmit",
    "capture": "tsx cli-capture.ts",
    "capture:list": "tsx cli-capture.ts --list",
    "render": "tsx cli-render.ts",
    "render:list": "tsx cli-render.ts --list",
    "selftest": "tsx cli-capture.ts --selftest",
    "selftest:demo": "tsx cli-selftest-demo.ts"
  },
  "dependencies": {
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "playwright": "^1.51.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
