# Ignore all content generated inside package manager test folders
/bun/*
/npm/*
/pnpm/*
/yarn/*

# The master scaffold the CLI produces, which the four folders above are copied
# from. Generated by `npm run capture -- --scaffold`, so it is build output like
# the copies are — and it carries the model key the pipeline seeds.
/app/

# Preserve README.md in test directories
!/bun/README.md
!/npm/README.md
!/pnpm/README.md
!/yarn/README.md

# Node / Next.js / Python artifacts
node_modules/
.next/
.venv/
__pycache__/
*.py[cod]
.env
.env.*
!.env.example
.copilotkit/
